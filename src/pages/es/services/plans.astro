---
import Layout from '../../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import OptimizedImage from '../../../components/OptimizedImage.astro';
import { buildLocalizedURL } from '../../../lib/i18n/utils';

const siteUrl = Astro.site ? Astro.site.toString() : Astro.url.origin;
const alternateUrls = {
  en: buildLocalizedURL(siteUrl, 'en', '/services/plans').toString(),
  es: buildLocalizedURL(siteUrl, 'es', '/services/plans').toString(),
};

// Importar el contenido existente de services.astro
const services = [
  {
    id: 'private',
    title: 'Eventos Privados',
    description: 'Celebraciones íntimas con cócteles personalizados que sorprenderán a tus invitados.',
    image: '/images/private_e.webp',
    placeholder: '/images/placeholders/private_e-placeholder.webp',
    features: [
      'Menú de cócteles personalizado',
      'Bartenders profesionales',
      'Bar móvil elegante',
      'Cristalería y utensilios',
      'Ingredientes de alta calidad',
      'Montaje y desmontaje'
    ],
    cta: 'Solicitar cotización'
  },
  {
    id: 'weddings',
    title: 'Bodas',
    description: 'Crea momentos mágicos con barras temáticas y cócteles que complementen tu día especial.',
    image: '/images/wedding_e.webp',
    placeholder: '/images/placeholders/wedding_e-placeholder.webp',
    features: [
      'Cócteles de firma personalizados',
      'Decoración temática del bar móvil',
      'Bartenders profesionales uniformados',
      'Cristalería premium',
      'Estación de aguas infusionadas',
      'Servicio de bebidas de bienvenida'
    ],
    cta: 'Planificar tu boda'
  },
  {
    id: 'corporate',
    title: 'Eventos Corporativos',
    description: 'Impresiona a clientes y colegas con un servicio profesional y sofisticado.',
    image: '/images/corporate_e.webp',
    placeholder: '/images/placeholders/corporate_e-placeholder.webp',
    features: [
      'Cócteles con la marca corporativa',
      'Bar móvil con logo de la empresa',
      'Bartenders profesionales',
      'Opciones con y sin alcohol',
      'Servicio de coffee break',
      'Facturación corporativa'
    ],
    cta: 'Cotización corporativa'
  },
  {
    id: 'themed',
    title: 'Fiestas Temáticas',
    description: 'Refuerza el tema de tu evento con cócteles y decoración perfectamente coordinados.',
    image: '/images/themed_p.webp',
    placeholder: '/images/placeholders/themed_p-placeholder.webp',
    features: [
      'Cócteles temáticos exclusivos',
      'Decoración de bar temática',
      'Vestimenta temática para bartenders',
      'Show de bartending',
      'Menú impreso personalizado',
      'Efectos especiales (hielo seco, flambeado)'
    ],
    cta: 'Crear mi fiesta temática'
  }
];

const packages = [
  {
    name: 'Maleta de Chupitos',
    price: '$60',
    priceLabel: 'precio inicial',
    description: 'Perfecto para comenzar la fiesta con tequila o vodka',
    features: [
      '24 Shots del Spiritz de tu preferencia',
      'Con acabado Lima-Limón-Naranja y Borde Salado',
      'Contacto para horarios'
    ],
    popular: false,
    category: 'addon'
  },
  {
    name: 'Bienvenida con Champán',
    price: '$80',
    priceLabel: 'precio inicial',
    description: 'Recibe a tus invitados con elegancia (50 personas)',
    features: [
      'Todos sus invitados serán recibidos con una copa',
      'Champán o prosecco de calidad',
      'Contacto para horarios'
    ],
    popular: false,
    category: 'addon'
  },
  {
    name: 'Personalizado',
    price: '$500',
    priceLabel: 'precio inicial',
    description: 'Paquete personalizable según tus necesidades',
    features: [
      'Servicio personalizado',
      'Adaptable a tu evento',
      'Contacto para horarios'
    ],
    popular: false,
    category: 'customized'
  },
  {
    name: 'Fiesta de Dito',
    price: '$750',
    priceLabel: 'precio inicial',
    description: 'Ideal para eventos medianos (50-100 invitados)',
    features: [
      'Elige 4 cócteles de nuestra variada carta',
      'Barra móvil con logotipo de la empresa',
      'Hielo',
      'Cristalería de plástico',
      'Estación de agua/infusión',
      'Contacto para horarios'
    ],
    popular: false,
    category: 'standard'
  },
  {
    name: 'Premium',
    price: '$1,050',
    priceLabel: 'precio inicial',
    description: 'La experiencia completa (50-120 invitados)',
    features: [
      'Elige 5 cócteles. Menú de cócteles personalizado',
      'Ingredientes y guarnición de alta calidad',
      'Hielo',
      'Estación de agua/infusión',
      'Opción de dos botellas diferentes de Cerveza y Vino',
      'Cristalería de plástico de primera calidad',
      'Barra móvil con logotipo de la empresa',
      'Contacto para horarios'
    ],
    popular: true,
    category: 'premium'
  }
];

const additionalInfo = [
  'Es posible que los precios iniciales no incluyan todas las tarifas que pueda cobrar el proveedor.',
];

// WhatsApp contact number
const whatsappNumber = '+17279454200';

// Function to create WhatsApp message
function createWhatsAppMessage(packageName: string, price: string, description: string): string {
  const message = `¡Hola!

Estoy interesado en el paquete *${packageName}* de Dito's Bartender.

 *Detalles del paquete:*
• Nombre: ${packageName}
• Precio: ${price}
• Descripción: ${description}

¿Podrían proporcionarme más información sobre disponibilidad y detalles adicionales?

¡Gracias!`;
  
  return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
}

// Function to create service WhatsApp message
function createServiceWhatsAppMessage(serviceName: string, description: string): string {
  const message = `¡Hola!

Estoy interesado en el servicio de *${serviceName}* de Dito's Bartender.

 *Servicio solicitado:*
• ${serviceName}
• ${description}

¿Podrían proporcionarme más información sobre disponibilidad, precios y detalles del servicio?

¡Gracias!`;
  
  return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
}

---

<Layout 
  title="Planes y Servicios | Dito's Bartender"
  description="Descubre nuestra amplia gama de servicios de bartender móvil para todo tipo de eventos. Cócteles personalizados, barras temáticas y experiencias únicas."
  alternateUrls={alternateUrls}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-20 bg-primary text-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Planes y Servicios</h1>
        <p class="text-xl text-white/80">
          Experiencias de bartending personalizadas para cada ocasión. Descubre cómo podemos hacer tu evento extraordinario.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Services Section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Nuestros Servicios</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Experiencias de bartending personalizadas para cada ocasión. Descubre cómo podemos hacer tu evento extraordinario.
        </p>
      </div>

      {services.map((service, index) => (
        <div id={service.id} class="py-16 border-b border-gray-200 last:border-0 relative">
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class={index % 2 === 0 ? 'order-2 lg:order-1' : 'order-2'}>
              <h2 class="text-3xl font-bold mb-6">{service.title}</h2>
              <p class="text-gray-600 mb-8 text-lg">{service.description}</p>
              <ul class="space-y-3 mb-8">
                {service.features.map(feature => (
                  <li class="flex items-start">
                    <Icon name="mdi:check-circle" class="w-6 h-6 text-primary mr-2 flex-shrink-0 mt-0.5" />
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
              <div class="space-y-4">
                <a 
                  href={createServiceWhatsAppMessage(service.title, service.description)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-primary hover:bg-primary-dark text-white font-semibold px-8 py-3 rounded-md transition-colors duration-300 inline-flex items-center group"
                >
                  <Icon name="mdi:whatsapp" class="w-5 h-5 mr-2" />
                  <span class="relative z-10">{service.cta}</span>
                  <Icon name="mdi:arrow-right" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" />
                </a>
                <p class="text-sm text-gray-600 flex items-center">
                  <Icon name="mdi:whatsapp" class="w-4 h-4 mr-2 text-green-500" />
                  Contacto directo por WhatsApp para respuesta inmediata
                </p>
              </div>
            </div>
            <div class={`${index % 2 === 0 ? 'order-1 lg:order-2' : 'order-1'} relative group`}>
              <OptimizedImage 
                src={service.image || "/placeholder.svg"} 
                alt={service.title} 
                width={600} 
                height={400}
                class="rounded-lg shadow-xl w-full h-[400px] object-cover transition-all duration-300 group-hover:brightness-105"
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "auto"}
                placeholder={service.placeholder}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-6">
                <span class="text-white text-lg font-semibold">¡Disponible Ahora!</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
  
  <!-- Packages Section -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Nuestros Paquetes</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          Ofrecemos diferentes opciones para adaptarnos a tus necesidades y presupuesto. Todos nuestros paquetes son personalizables.
        </p>
      </div>
      
      <!-- Package Categories -->
      <div class="mb-12">
        <!-- Add-ons Section -->
        <div class="mb-16">
          <h3 class="text-2xl font-bold text-center mb-8">Complementos Especiales</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
            {packages.filter(pkg => pkg.category === 'addon').map(pkg => (
              <div class="bg-white rounded-lg shadow-lg overflow-hidden border-2 border-accent/20 hover:border-accent/40 transition-all duration-300 hover:-translate-y-1">
                <div class="p-6">
                  <h4 class="text-xl font-bold mb-2">{pkg.name}</h4>
                  <div class="flex items-baseline mb-4">
                    <span class="text-3xl font-bold text-primary">{pkg.price}</span>
                    <span class="text-gray-500 ml-2">{pkg.priceLabel}</span>
                  </div>
                  <p class="text-gray-600 mb-6">{pkg.description}</p>
                  <ul class="space-y-2 mb-6">
                    {pkg.features.map(feature => (
                      <li class="flex items-start text-sm">
                        <Icon name="mdi:check-circle" class="w-4 h-4 text-primary mr-2 flex-shrink-0 mt-0.5" />
                        <span class="text-gray-600">{feature}</span>
                      </li>
                    ))}
                  </ul>
                  <a 
                    href={createWhatsAppMessage(pkg.name, pkg.price, pkg.description)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full text-center bg-accent hover:bg-accent-dark text-secondary font-semibold px-4 py-2 rounded-md transition-colors duration-300 inline-flex items-center justify-center"
                  >
                    <Icon name="mdi:whatsapp" class="w-4 h-4 mr-2" />
                    Agregar a mi evento
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Main Packages -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {packages.filter(pkg => pkg.category !== 'addon').map(pkg => (
            <div class={`bg-white rounded-lg shadow-lg overflow-hidden transition-transform duration-300 hover:-translate-y-2 ${pkg.popular ? 'ring-2 ring-accent relative scale-105' : ''}`}>
              {pkg.popular && (
                <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 z-10">
                  <div class="bg-accent text-secondary font-semibold px-6 py-2 rounded-full shadow-lg">
                    <span class="flex items-center">
                      <Icon name="mdi:star" class="w-4 h-4 mr-1" />
                      Los más populares
                    </span>
                  </div>
                </div>
              )}
              <div class="p-8">
                <h3 class="text-2xl font-bold mb-2">{pkg.name}</h3>
                <div class="flex items-baseline mb-4">
                  <span class="text-3xl font-bold text-primary">{pkg.price}</span>
                  <span class="text-gray-500 ml-2">{pkg.priceLabel}</span>
                </div>
                <p class="text-gray-600 mb-6">{pkg.description}</p>
                <ul class="space-y-3 mb-8">
                  {pkg.features.map(feature => (
                    <li class="flex items-start">
                      <Icon name="mdi:check-circle" class="w-5 h-5 text-primary mr-2 flex-shrink-0 mt-0.5" />
                      <span class="text-gray-600">{feature}</span>
                    </li>
                  ))}
                </ul>
                <a 
                  href={createWhatsAppMessage(pkg.name, pkg.price, pkg.description)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`w-full text-center font-semibold px-6 py-3 rounded-md transition-all duration-300 transform hover:scale-105 inline-flex items-center justify-center ${pkg.popular ? 'bg-accent hover:bg-accent-dark text-secondary shadow-lg' : 'bg-primary hover:bg-primary-dark text-white'}`}
                >
                  <Icon name="mdi:whatsapp" class="w-4 h-4 mr-2" />
                  Solicitar cotización
                </a>
              </div>
            </div>
          ))}
        </div>
        
        <!-- Additional Information -->
        <div class="mt-12 bg-gray-100 rounded-lg p-6">
          <h4 class="font-semibold text-gray-800 mb-4">Información Importante:</h4>
          <ul class="space-y-2">
            {additionalInfo.map(info => (
              <li class="flex items-start text-gray-600">
                <Icon name="mdi:information-outline" class="w-5 h-5 text-primary mr-2 flex-shrink-0 mt-0.5" />
                <span>{info}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      
      <div class="text-center mt-16">
        <p class="text-gray-600 mb-4">¿No encuentras lo que buscas? Podemos crear un paquete personalizado para ti.</p>
        <a 
          href={createWhatsAppMessage('Cotización Personalizada', 'Precio a consultar', 'Servicio completamente personalizado según las necesidades específicas del evento')}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-transparent hover:bg-primary text-primary hover:text-white border border-primary font-semibold px-8 py-3 rounded-md transition-colors duration-300 inline-flex items-center"
        >
          <Icon name="mdi:whatsapp" class="w-5 h-5 mr-2" />
          Contáctanos para una cotización personalizada
          <Icon name="mdi:arrow-right" class="w-5 h-5 ml-2" />
        </a>
      </div>
    </div>
  </section>
  
  <!-- CTA Section -->
  <section class="py-20 bg-primary text-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">¿Listo para elevar tu evento?</h2>
        <p class="text-xl text-white/80 mb-8">
          No importa el tamaño o tipo de evento, tenemos la solución perfecta para ti. Permítenos crear una experiencia inolvidable para tus invitados.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href={createWhatsAppMessage('Consulta General', 'Precio a consultar', 'Solicitud de información general sobre servicios de bartending móvil')}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-accent hover:bg-accent-dark text-secondary font-semibold px-8 py-4 rounded-md transition-colors duration-300 inline-flex items-center"
          >
            <Icon name="mdi:whatsapp" class="w-5 h-5 mr-2" />
            Solicitar Cotización
          </a>
          <a 
            href="/es/services/menu" 
            class="bg-transparent hover:bg-white/10 border-2 border-white text-white font-semibold px-8 py-4 rounded-md transition-colors duration-300"
          >
            Ver Menú de Cócteles
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>