---
import OptimizedImage from '../OptimizedImage.astro';

const galleryImages = [
  {
    src: '/images/trailer_bar.webp',
    alt: 'Mobile bar at corporate event',
    category: 'Corporate'
  },
  {
    src: '/images/exclusive_cocktail.webp',
    alt: 'Exclusive cocktail preparation',
    category: 'Cocktails'
  },
  {
    src: '/images/bar_table.webp',
    alt: 'Themed bar for any party',
    category: 'Weddings'
  },
  {
    src: '/images/bartender.webp',
    alt: 'Bartending service at private party',
    category: 'Private Events'
  },
  {
    src: '/images/cocktail_presentation.webp',
    alt: 'Cocktail presentation detail',
    category: 'Cocktails'
  },
  {
    src: '/images/drink.webp',
    alt: 'Mobile bar decorated for themed event',
    category: 'Themed'
  }
];

// Load first 3 images with high priority
const priorityImages = galleryImages.slice(0, 3);
const regularImages = galleryImages.slice(3);
---

<section id="gallery" class="py-12 md:py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-8 md:mb-16 scroll-trigger">
      <h2 class="text-3xl md:text-4xl font-bold mb-3 md:mb-4">Our Gallery</h2>
      <p class="text-gray-600 max-w-2xl mx-auto text-sm md:text-base">
        Discover the magic of our events through images that capture the essence of our mobile bartending service.
      </p>
    </div>
    
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 md:gap-6">
      {priorityImages.map((image, index) => (
        <div 
          class="group relative overflow-hidden rounded-lg shadow-lg scroll-trigger hover-lift" 
          style={`animation-delay: ${index * 100}ms;`}
        >
          <OptimizedImage 
            src={image.src} 
            alt={image.alt} 
            width={800} 
            height={533}
            loading="eager"
            fetchpriority="high"
            class="w-full h-44 md:h-80 object-cover transition-transform duration-700 group-hover:scale-110"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-300 flex flex-col justify-end p-3 md:p-6 transform translate-y-4 group-hover:translate-y-0">
            <span class="text-accent text-xs md:text-sm font-medium">{image.category}</span>
            <h3 class="text-white text-sm md:text-xl font-semibold line-clamp-2">{image.alt}</h3>
          </div>
        </div>
      ))}

      {regularImages.map((image, index) => (
        <div 
          class={`group relative overflow-hidden rounded-lg shadow-lg scroll-trigger hover-lift ${index >= 1 ? 'hidden lg:block' : ''}`}
          style={`animation-delay: ${(index + 3) * 100}ms;`}
        >
          <OptimizedImage 
            src={image.src} 
            alt={image.alt} 
            width={800} 
            height={533}
            loading="lazy"
            class="w-full h-44 md:h-80 object-cover transition-transform duration-700 group-hover:scale-110"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-300 flex flex-col justify-end p-3 md:p-6 transform translate-y-4 group-hover:translate-y-0">
            <span class="text-accent text-xs md:text-sm font-medium">{image.category}</span>
            <h3 class="text-white text-sm md:text-xl font-semibold line-clamp-2">{image.alt}</h3>
          </div>
        </div>
      ))}
    </div>
    
    <div class="text-center mt-8 md:mt-12 scroll-trigger" style="animation-delay: 300ms;">
      <a 
        href="/gallery" 
        class="bg-primary hover:bg-primary-dark text-white font-semibold px-8 py-3 rounded-md transition-all duration-300 hover:shadow-lg hover:scale-[1.02] active:scale-[0.98]"
      >
        View full gallery
      </a>
    </div>
  </div>
</section>

<style>
  /* Estilos específicos para esta sección */
  .scroll-trigger {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
  }
  
  .scroll-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

