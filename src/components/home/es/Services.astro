---
import { Icon } from 'astro-icon/components';

const services = [
  {
    icon: 'mdi:glass-wine',
    title: 'Eventos Privados',
    description: 'Celebraciones íntimas con cócteles personalizados que sorprenderán a tus invitados.',
    link: '/es/services/plans#private'
  },
  {
    icon: 'mdi:ring',
    title: 'Bodas',
    description: 'Crea momentos mágicos con barras temáticas y cócteles que complementen tu día especial.',
    link: '/es/services/plans#weddings'
  },
  {
    icon: 'mdi:office-building',
    title: 'Corporativo',
    description: 'Impresiona a clientes y colegas con un servicio profesional y sofisticado.',
    link: '/es/services/plans#corporate'
  },
  {
    icon: 'mdi:party-popper',
    title: 'Fiestas Temáticas',
    description: 'Refuerza la temática de tu evento con cócteles y decoración perfectamente coordinados.',
    link: '/es/services/plans#themed'
  }
];
---

<section id="services" class="py-12 md:py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-8 md:mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-3 md:mb-4">Nuestros Servicios</h2>
      <p class="text-gray-600 max-w-2xl mx-auto text-sm md:text-base">
        Ofrecemos experiencias de bartender personalizadas para todo tipo de eventos, adaptándonos a tus necesidades y superando tus expectativas.
      </p>
    </div>
    
    <!-- Mobile: Carrusel horizontal | Desktop: Grid -->
    <div class="services-carousel-es flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 -mx-4 px-4 md:grid md:grid-cols-2 lg:grid-cols-4 md:gap-8 md:overflow-visible md:snap-none md:pb-0 md:mx-0 md:px-0">
      {services.map(service => (
        <div class="min-w-[280px] w-[85vw] md:min-w-0 md:w-auto snap-center flex-shrink-0 md:flex-shrink bg-white rounded-lg shadow-lg p-5 md:p-8 transition-transform duration-300 hover:-translate-y-2">
          <div class="text-primary mb-3 md:mb-4">
            <Icon name={service.icon} class="w-10 h-10 md:w-12 md:h-12" />
          </div>
          <h3 class="text-lg md:text-xl font-bold mb-2 md:mb-3">{service.title}</h3>
          <p class="text-gray-600 text-sm md:text-base mb-3 md:mb-4">{service.description}</p>
          <a 
            href={service.link} 
            class="text-primary hover:text-primary-dark font-medium inline-flex items-center transition-colors duration-300 text-sm md:text-base"
          >
            Ver más
            <Icon name="mdi:arrow-right" class="w-4 h-4 md:w-5 md:h-5 ml-1" />
          </a>
        </div>
      ))}
    </div>

    <!-- Indicadores de scroll móvil -->
    <div class="flex justify-center gap-2 mt-4 md:hidden" aria-hidden="true">
      {services.map((_, i) => (
        <span class="services-dot-es w-2 h-2 rounded-full bg-gray-300 transition-colors duration-300" data-index={i}></span>
      ))}
    </div>
    
    <div class="text-center mt-8 md:mt-12">
      <a 
        href="/es/services/plans" 
        class="bg-primary hover:bg-primary-dark text-white font-semibold px-8 py-3 rounded-md transition-colors duration-300 inline-flex items-center justify-center"
      >
        Ver todos los servicios
        <Icon name="mdi:arrow-right" class="w-5 h-5 ml-2" />
      </a>
    </div>
  </div>
</section>

<style>
  .services-carousel-es {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .services-carousel-es::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 768px) {
    .services-carousel-es {
      overflow: visible;
      flex-wrap: wrap;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const carousel = document.querySelector('.services-carousel-es') as HTMLElement;
    const dots = document.querySelectorAll('.services-dot-es');
    
    if (carousel && dots.length > 0) {
      const updateDots = () => {
        const scrollLeft = carousel.scrollLeft;
        const cardWidth = carousel.children[0]?.clientWidth || 280;
        const gap = 16;
        const activeIndex = Math.round(scrollLeft / (cardWidth + gap));
        
        dots.forEach((dot, i) => {
          dot.classList.toggle('bg-primary', i === activeIndex);
          dot.classList.toggle('bg-gray-300', i !== activeIndex);
        });
      };
      
      carousel.addEventListener('scroll', updateDots, { passive: true });
      updateDots();
    }
  });
</script>
