---
/**
 * CHRISTMAS COMPONENT: Snowfall
 * 
 * Creates animated snowflakes falling across the screen.
 * Only renders when Christmas theme is active.
 * 
 * REMOVAL: Delete this file and remove import from Layout.astro
 */
interface Props {
  density?: 'light' | 'medium' | 'heavy';
}

const { density = 'medium' } = Astro.props;

// Number of snowflakes based on density
const snowflakeCount = {
  light: 25,
  medium: 40,
  heavy: 60
}[density];

// Generate random snowflake data
const snowflakes = Array.from({ length: snowflakeCount }, (_, i) => ({
  id: i,
  left: Math.random() * 100,
  delay: Math.random() * 5,
  duration: 8 + Math.random() * 7,
  size: ['small', 'medium', 'large'][Math.floor(Math.random() * 3)],
  sway: Math.random() > 0.5
}));
---

<div id="snowfall-container" class="snowfall-container" aria-hidden="true" style="display: none;">
  {snowflakes.map((flake) => (
    <span
      class:list={[
        'snowflake',
        flake.size,
        { 'sway': flake.sway }
      ]}
      style={`
        left: ${flake.left}%;
        animation-delay: ${flake.delay}s;
        animation-duration: ${flake.duration}s;
      `}
    >
      ❄
    </span>
  ))}
</div>

<script>
  // Only show snowfall when Christmas theme is active
  function initSnowfall() {
    const container = document.getElementById('snowfall-container');
    if (!container) return;
    
    // Check if user prefers reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      container.style.display = 'none';
      return;
    }
    
    // Check Christmas theme state
    const isChristmasActive = localStorage.getItem('christmasTheme') !== 'disabled';
    container.style.display = isChristmasActive ? 'block' : 'none';
    
    // Listen for theme changes
    window.addEventListener('christmas-theme-toggle', ((e: any) => {
      const isChristmasActive = e.detail?.active ?? false;
      container.style.display = isChristmasActive ? 'block' : 'none';
    }) as EventListener);
  }
  
  document.addEventListener('astro:page-load', initSnowfall);
</script>
