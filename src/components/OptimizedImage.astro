---
import { Image } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'auto' | 'sync';
  fetchpriority?: 'high' | 'low' | 'auto';
  quality?: number;
  aspectRatio?: string;
}

const { 
  src, 
  alt, 
  width = 800, 
  height = 533,
  class: className = '',
  loading = 'lazy',
  decoding = 'async',
  fetchpriority,
  quality = 80,
  aspectRatio = '3/2'
} = Astro.props;

// Generar sizes responsive
const sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw';

// Generar widths para srcset (responsive breakpoints)
const widths = [400, 600, 800, 1200];
---

<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  widths={widths}
  sizes={sizes}
  class={className}
  loading={loading}
  decoding={decoding}
  fetchpriority={fetchpriority}
  quality={quality}
  format="webp"
  style={`aspect-ratio: ${aspectRatio};`}
/>

<style>
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>